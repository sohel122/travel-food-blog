{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profiles representing users and admins.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique user ID from Firebase Auth." },
        "name": { "type": "string", "description": "Display name of the user." },
        "email": { "type": "string", "description": "Email address of the user." },
        "bio": { "type": "string", "description": "Short bio of the user." },
        "photoURL": { "type": "string", "description": "Profile picture URL." },
        "isAdmin": { "type": "boolean", "description": "Flag indicating if user has admin privileges." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the profile was created." }
      },
      "required": ["uid", "name", "email", "isAdmin"]
    },
    "Post": {
      "title": "Post",
      "description": "Travel and food blog post.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the post." },
        "title": { "type": "string", "description": "Title of the post." },
        "slug": { "type": "string", "description": "URL slug generated from title." },
        "content": { "type": "string", "description": "Full HTML or markdown content of the post." },
        "excerpt": { "type": "string", "description": "Short description of the post." },
        "coverImage": { "type": "string", "description": "Image URL for the post cover." },
        "youtubeUrl": { "type": "string", "description": "Optional YouTube video embed URL." },
        "categoryId": { "type": "string", "description": "Associated Category ID." },
        "categoryName": { "type": "string", "description": "Category name for denormalization." },
        "isFeatured": { "type": "boolean", "description": "Whether the post is pinned to featured sections." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp." },
        "author": { "type": "object", "description": "Author user summary." },
        "likes": { "type": "integer", "description": "Number of likes/upvotes for this post." }
      },
      "required": ["id", "title", "slug", "content", "coverImage", "categoryId", "categoryName", "isFeatured", "createdAt"]
    },
    "Like": {
      "title": "Like",
      "description": "User like on a post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of user who liked." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when liked." }
      },
      "required": ["userId"]
    },
    "Category": {
      "title": "Category",
      "description": "Blog post category.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique category identifier." },
        "name": { "type": "string", "description": "Name of the category." },
        "slug": { "type": "string", "description": "URL slug." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["id", "name", "slug", "createdAt"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Contact form submissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique submission ID." },
        "name": { "type": "string", "description": "Name of the submitter." },
        "email": { "type": "string", "description": "Email of the submitter." },
        "subject": { "type": "string", "description": "Subject line." },
        "message": { "type": "string", "description": "Message content." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp." },
        "isRead": { "type": "boolean", "description": "Read status." }
      },
      "required": ["id", "name", "email", "subject", "message", "createdAt", "isRead"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comments on blog posts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique comment identifier." },
        "postId": { "type": "string", "description": "ID of the commented post." },
        "text": { "type": "string", "description": "Text content of the comment." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "author": { "type": "object", "description": "Author of the comment containing name, email, and photoURL." }
      },
      "required": ["postId", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User documents"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Blog posts documents"
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": "Like",
      "description": "Like records for a post by user ID"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Blog categories documents"
    },
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Contact message submissions"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "User comments on blog posts"
    }
  }
}
